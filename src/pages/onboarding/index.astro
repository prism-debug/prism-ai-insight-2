---
import '../../styles/onboarding.css';
import AppShell from '../../layouts/AppShell.astro';
import Icon from '../../components/Icon.astro';
import Avatar from '../../components/Avatar.astro';
import ProgressRing from '../../components/onboarding/ProgressRing.astro';
import SectionRow from '../../components/onboarding/SectionRow.astro';
import { SALON, SERVICES, STYLISTS } from '../../data/salon.ts';
import { SECTIONS, REQUIRED_FILES, OPTIONAL_FILES, src } from '../../data/onboarding.ts';
const pb = SALON.booking.system;
const mins = SECTIONS.reduce((a, s) => a + s.minutes, 0);
const tiles = [src('website'), ...REQUIRED_FILES];
---
<AppShell title="Salon setup" active="onboarding" description={`Set up ${SALON.name} in PRISM: connect ${pb}, add a few files, then check each section.`}>
  <div class="ob ob-hub">
    <section class="ob-card ob-hero" aria-labelledby="ob-h1">
      <ProgressRing size={72} />
      <div class="ob-hero-copy">
        <h1 class="ob-h1" id="ob-h1">Let’s get <span data-bind="salon">{SALON.name}</span> ready</h1>
        <p class="t-small muted"><span class="tnum" data-bind="done">0</span> of {SECTIONS.length} sections set up · about <span class="tnum" data-bind="mins">{mins}</span> min left · saves as you go</p>
      </div>
      <a class="btn" href="/onboarding/files" data-continue>Continue setup<Icon name="arrow-right" size={14} /></a>
    </section>

    <section class="ob-card ob-hstep" data-hub-step="connect" data-state="todo" aria-labelledby="ob-s1">
      <span class="ob-stepnum" aria-hidden="true"><span class="n">1</span><Icon name="check" size={14} sw={3} class="ok" /></span>
      <div class="ob-hstep-copy">
        <h2 class="ob-h2" id="ob-s1"><span class="when-todo">Connect <span data-bind="crm">{pb}</span></span><span class="when-done"><span data-bind="crm">{pb}</span> connected</span></h2>
        <p class="t-small muted"><span class="when-todo">Brings in your services, prices, team and hours. Read-only, nothing changes in <span data-bind="crm">{pb}</span>.</span><span class="when-done">{SERVICES.length} services, {STYLISTS.length} stylists, hours synced</span></p>
      </div>
      <button type="button" class="btn btn-black when-todo" data-pick="phorest">Connect <span data-bind="crm">{pb}</span><span class="arrow"><Icon name="arrow-right" size={14} /></span></button>
      <a class="btn btn-sm when-done" href="/onboarding/connections">Manage</a>
      <div class="ob-crm-ask when-todo" data-crm-ask hidden>
        <p class="t-small muted">You weren’t sure at signup. Pick the one your salon books with and we’ll connect it.</p>
        <div class="ob-crm-ask-btns">
          <button type="button" class="btn" data-crm-choose="phorest"><Icon name="calendar-sync" size={14} />Phorest</button>
          <button type="button" class="btn" data-crm-choose="zenoti"><Icon name="calendar-sync" size={14} />Zenoti</button>
        </div>
      </div>
    </section>

    <section class="ob-card ob-hstep" data-hub-step="files" data-state="todo" aria-labelledby="ob-s2">
      <span class="ob-stepnum" aria-hidden="true"><span class="n">2</span><Icon name="check" size={14} sw={3} class="ok" /></span>
      <div class="ob-hstep-copy">
        <h2 class="ob-h2" id="ob-s2">Add a few files</h2>
        <p class="t-small muted">Prism reads them and fills your policies, brand, FAQs and photos. <span class="tnum" data-bind="files-n">0/{REQUIRED_FILES.length}</span> added.</p>
      </div>
      <a class="btn btn-sm" href="/onboarding/files" data-files-cta>Add files</a>
      <ul class="ob-tiles">
        {tiles.map((s) => (
          <li class="ob-tile" data-src-tile={s.id} data-ready="false">
            <Icon name={s.icon} size={15} class="ob-tile-i" />
            <strong>{s.kind === 'link' ? 'Website' : s.label}</strong>
            <span class="ob-tile-state"><Icon name="check" size={11} sw={3} class="ok" /></span>
          </li>
        ))}
      </ul>
      <details class="ob-opt">
        <summary><Icon name="chevron-right" size={13} class="ob-opt-chev" />Optional: price list and team bios</summary>
        <p class="t-small muted"><span data-bind="crm">{pb}</span> already has your services, prices and team. Add a price list or team bios only if they say something <span data-bind="crm">{pb}</span> doesn’t, like menu wording or stylist bios.</p>
        <ul class="ob-tiles">
          {OPTIONAL_FILES.map((s) => (
            <li class="ob-tile" data-src-tile={s.id} data-ready="false">
              <Icon name={s.icon} size={15} class="ob-tile-i" />
              <strong>{s.label}</strong>
              <span class="ob-tile-state"><Icon name="check" size={11} sw={3} class="ok" /></span>
            </li>
          ))}
        </ul>
      </details>
    </section>

    <section class="ob-card ob-hstep ob-hstep-list" aria-labelledby="ob-s3">
      <span class="ob-stepnum" aria-hidden="true"><span class="n">3</span></span>
      <div class="ob-hstep-copy">
        <h2 class="ob-h2" id="ob-s3">Check each section</h2>
        <p class="t-small muted">Prism fills these in. Confirm each one, or fix anything that looks off.</p>
      </div>
      <ol class="ob-rows">{SECTIONS.map((s) => <SectionRow section={s} />)}</ol>
    </section>

    <section class="ob-card ob-summary" aria-labelledby="ob-sum">
      <div class="ob-sum-intro">
        <Avatar kind="joy" size="md" />
        <div>
          <h2 class="t-head" id="ob-sum">What Joy knows so far</h2>
          <p class="t-small muted" data-sum-sub>Nothing yet. Connect <span data-bind="crm">{pb}</span> and Prism starts filling this in.</p>
        </div>
      </div>
      <dl class="ob-sum-metrics">
        <div><dt>Facts confirmed</dt><dd class="tnum" data-bind="confirmed">0</dd></div>
        <div class="attn"><dt>Conflicts</dt><dd class="tnum" data-bind="conflicts">0</dd></div>
        <div><dt>Readiness</dt><dd class="tnum"><span data-bind="ready">0</span><small>/100</small></dd></div>
      </dl>
      <div class="ob-gaps">
        <p class="ob-joy-label">Top gaps</p>
        <ul data-gaps></ul>
      </div>
    </section>
  </div>
</AppShell>
<script>import '../../scripts/onboarding.ts';</script>
