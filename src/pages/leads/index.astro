---
import AppShell from '../../layouts/AppShell.astro';
import Icon from '../../components/Icon.astro';
import StatusIcon from '../../components/StatusIcon.astro';
import LeadRow from '../../components/leads/LeadRow.astro';
import BoardCard from '../../components/leads/BoardCard.astro';
import { NOW } from '../../data/clock.ts';
import { SOURCES, SERVICES, source, service } from '../../data/salon.ts';
import { WINDOW, JOY_CHANNELS, JOY_PAUSED_WHY, STATUS_ORDER, STATUS_LABEL, STATUS_RULE, OWNERS, listModel, isWaiting, viewCount, LIST_ORDER } from '../../data/leads.ts';
import { money } from '../../lib/format.ts';

const sorted = LIST_ORDER;
const by = (s: string) => sorted.filter((l) => l.status === s);
const sum = (arr: typeof WINDOW) => arr.reduce((t, l) => t + l.likelyValue, 0);
const models = WINDOW.map(listModel);
const meta = {
  now: NOW, joyChannels: JOY_CHANNELS, pausedWhy: JOY_PAUSED_WHY, order: LIST_ORDER.map((l) => l.id),
  statusLabel: STATUS_LABEL, statusRule: STATUS_RULE,
  sources: Object.fromEntries(SOURCES.map((s) => [s.id, s.name])),
  services: Object.fromEntries(SERVICES.map((s) => [s.id, s.name])),
  owners: Object.fromEntries(OWNERS.map((o) => [o.id, o.name])),
};
const nA = by('not_answered').length, nP = by('needs_person').length;
const views = [
  { id: 'needs', label: 'Needs you first', tip: 'Not answered plus needs a person: the same waiting count as the sidebar' }, { id: 'hot', label: 'Hot leads', tip: 'Score 70 or more' }, { id: 'after', label: 'After hours', tip: 'Asked while the salon was closed' }, { id: 'joybooked', label: 'Booked by Joy', tip: 'Joy sent the first reply and the guest booked' }, { id: 'all', label: 'All', tip: 'Every lead in the last 30 days' },
];
const chips = [
  { key: 'status', label: 'Status', opts: STATUS_ORDER.map((s) => [s, STATUS_LABEL[s]]) },
  { key: 'source', label: 'Source', opts: SOURCES.map((s) => [s.id, s.name]) },
  { key: 'service', label: 'Service', opts: SERVICES.map((s) => [s.id, s.name]) },
  { key: 'owner', label: 'Handler', opts: [...OWNERS.map((o) => [o.id, o.name]), ['none', 'Unassigned']] },
  { key: 'consent', label: 'Consent', opts: [['sms', 'Can text about appointments'], ['nosms', 'No text consent'], ['promo', 'Can get promotional texts']] },
];
---
<AppShell title="Leads" active="leads" flush description="Everyone who asked, and who needs what next.">
  <button slot="actions" class="btn btn-sm hide-m" data-toast="Add a lead from Forms or the Inbox. Walk-ins are logged from a lead’s row."><Icon name="user-plus" size={14} />Add lead</button>

  <div slot="toolbar" class="ltool">
    <div class="toolbar lt-row" role="toolbar" aria-label="Views and display">
      <div class="tabs" role="tablist" aria-label="Saved views">
        {views.map((v) => <button class="tab" role="tab" data-view={v.id} title={v.tip} aria-selected={v.id === 'needs' ? 'true' : 'false'}>{v.label}<span class="count tnum" data-view-count={v.id}>{viewCount(v.id)}</span></button>)}
      </div>
      <button type="button" class="tm-trig view-trig" data-menu="menu-views" aria-haspopup="menu" aria-label="Choose a saved view"><span data-view-label>Needs you first</span><span class="muted tnum" data-view-now></span><Icon name="chevron-down" size={16} /></button>
      <span class="grow"></span>
      <div class="cluster list-tools">
        <button class="chip filter-btn" id="btn-filters" aria-pressed="false" aria-label="Filter leads" title="Filter by status, source, service, owner or consent"><Icon name="list-filter" size={14} /><span class="chip-t">Filter</span></button>
        <button class="icon-btn" data-menu="menu-display" aria-label="Display options" aria-haspopup="menu" title="Display options"><Icon name="sliders-horizontal" size={16} /></button>
        <div class="seg" role="group" aria-label="Layout">
          <button data-mode="list" aria-pressed="true" aria-label="List view" title="List"><Icon name="layout-list" size={14} /></button>
          <button data-mode="board" aria-pressed="false" aria-label="Board view" title="Board"><Icon name="columns-3" size={14} /></button>
        </div>
      </div>
    </div>
    <div class="toolbar lt-row" id="filter-row" hidden>
      <label class="lsearch"><Icon name="search" size={14} /><input class="input" id="lead-search" type="search" placeholder="Search name, service or phone" autocomplete="off" aria-label="Search leads" /></label>
      {chips.map((c) => <button class="chip" data-menu={`menu-${c.key}`} data-chip={c.key} data-label={c.label} aria-haspopup="menu"><Icon name="plus" size={13} /><span class="chip-t">{c.label}</span></button>)}
      <button class="chip on" id="clear-filters" hidden><Icon name="x" size={13} />Clear filters</button>
    </div>
  </div>

  <div class="leads" id="leads-app" data-mode="list">
    <div id="list-view">
      <p class="l-sub t-small muted" id="wait-sum"><span data-wait-n>{nA + nP}</span> waiting = <span data-wait-a>{nA}</span> not answered + <span data-wait-p>{nP}</span> {nP === 1 ? 'needs' : 'need'} a person.</p>
      <div class="row head lead-row sticky" aria-hidden="true">
        <span class="cell c-sel"><input class="check" type="checkbox" id="select-all" aria-label="Select all shown" /></span>
        <span class="cell c-state"></span><span class="cell">Lead</span><span class="cell c-src">Source</span><span class="cell right">Score</span><span class="cell right">Likely value</span><span class="cell">Handler</span><span class="cell right">Waiting</span><span class="cell"></span>
      </div>
      <div id="groups">
        {STATUS_ORDER.map((s) => (
          <section class="group" data-key={s} data-collapsed="false">
            <button class="group-head" type="button"><Icon name="chevron-down" size={14} class="chev" /><StatusIcon state={s} /><span>{STATUS_LABEL[s]}</span><span class="count">{by(s).length}</span><span class="gval muted t-small tnum">{money(sum(by(s)))} likely</span></button>{s === 'not_answered' && <p class="group-note muted t-small hide-m">Joy answers texts and DMs. These asked by phone, form or email, or came when Joy was off.</p>}
            <div class="group-body">{by(s).map((l) => <LeadRow lead={l} />)}</div>
          </section>
        ))}
      </div>
      <p class="lfoot t-meta hide-m"><span class="kbd">j</span><span class="kbd">k</span> move <span class="kbd">x</span> select <span class="kbd">↵</span> open</p>
    </div>

    <div id="board-view" hidden>
      <div class="rule-bar" id="rule-bar" hidden role="status">
        <Icon name="hand" size={16} />
        <p><strong id="rule-title"></strong> <span id="rule-text" class="muted"></span></p>
        <button class="btn btn-sm" id="rule-cancel">Cancel</button><button class="btn btn-sm btn-primary" id="rule-ok">Move</button>
      </div>
      <div class="board" id="board">
        {STATUS_ORDER.map((s) => (
          <section class="bcol" data-col={s} aria-label={STATUS_LABEL[s]} title={STATUS_RULE[s]}>
            <header class="bcol-head"><StatusIcon state={s} /><span class="strong">{STATUS_LABEL[s]}</span><span class="count muted tnum" data-ccount>{by(s).length}</span><span class="muted t-small tnum cval" data-cval>{money(sum(by(s)))}</span></header>
            <div class="bcol-body">{by(s).map((l) => <BoardCard lead={l} />)}</div>
          </section>
        ))}
      </div>
    </div>

    <div class="empty" id="lead-empty" hidden>
      <Icon name="search" size={22} />
      <strong>No leads match these filters</strong>
      <span>Views on the left are saved filters. Chips narrow by status, source, service, who is looking after a lead, and text consent. Search finds a name, service or phone number.</span>
      <button class="btn btn-sm" id="empty-clear">Clear filters</button>
    </div>
  </div>

  <div class="bulk" id="bulk" hidden role="region" aria-label="Bulk actions">
    <span class="strong tnum" id="bulk-n"></span>
    <button class="btn btn-sm" data-menu="menu-assign" aria-haspopup="menu"><Icon name="user-round" size={13} />Assign</button>
    <button class="btn btn-sm" id="bulk-joy"><Icon name="sparkles" size={13} />Hand back to Joy</button>
    <button class="btn btn-sm" data-menu="menu-sequence" aria-haspopup="menu"><Icon name="list-todo" size={13} />Add to sequence</button>
    <button class="btn btn-sm" id="bulk-text"><Icon name="message-square" size={13} />Text</button>
    <button class="btn btn-sm btn-danger" id="bulk-spam"><Icon name="ban" size={13} />Mark as spam</button>
    <button class="icon-btn" id="bulk-clear" aria-label="Clear selection"><Icon name="x" size={15} /></button>
  </div>

  <!-- menus -->
  <div class="menu" id="menu-views" role="menu">{views.map((v) => <button class="menu-item" role="menuitem" data-view={v.id} title={v.tip}>{v.label}<span class="muted tnum" data-view-count={v.id} style="margin-left:auto;padding-left:16px">{viewCount(v.id)}</span></button>)}</div>
  <div class="menu" id="menu-display" role="menu">
    <div class="menu-head">Grouping</div>
    {[['status', 'Status'], ['source', 'Source'], ['service', 'Service'], ['none', 'None']].map(([v, t]) => <button class="menu-item" role="menuitemradio" aria-checked="false" data-group={v}><span class="ck"><Icon name="check" size={14} /></span>{t}</button>)}
    <div class="menu-sep"></div>
    <div class="menu-head">Ordering</div>
    {[['needs', 'Needs you first'], ['newest', 'Newest'], ['score', 'Score'], ['value', 'Likely value']].map(([v, t]) => <button class="menu-item" role="menuitemradio" aria-checked="false" data-order={v}><span class="ck"><Icon name="check" size={14} /></span>{t}</button>)}
  </div>
  {chips.map((c) => (
    <div class="menu" id={`menu-${c.key}`} role="menu">
      <div class="menu-head">{c.label}</div>
      {c.opts.map(([v, t]) => <button class="menu-item" role="menuitemcheckbox" aria-checked="false" data-filter={c.key} data-value={v}><span class="ck"><Icon name="check" size={14} /></span>{t}</button>)}
    </div>
  ))}
  <div class="menu" id="menu-row" role="menu">
    <div class="menu-head">Log what you did</div>
    <button class="menu-item" data-log="texted"><Icon name="message-square" size={15} />Texted</button>
    <button class="menu-item" data-log="called"><Icon name="phone" size={15} />Called</button>
    <button class="menu-item" data-log="emailed"><Icon name="mail" size={15} />Emailed</button>
    <button class="menu-item" data-log="sent a DM to"><Icon name="camera" size={15} />Sent a DM</button>
    <button class="menu-item" data-log="saw in person"><Icon name="footprints" size={15} />Walked in</button>
    <div class="menu-sep"></div>
    <a class="menu-item" id="row-open" href="/inbox"><Icon name="message-circle" size={15} />Open conversation</a>
    <button class="menu-item" data-row-act="joy"><Icon name="sparkles" size={15} />Hand back to Joy</button>
    <button class="menu-item" data-row-act="client"><Icon name="user-check" size={15} />Mark as client</button>
  </div>
  <div class="menu" id="menu-move" role="menu">
    <div class="menu-head">Move to</div>
    {STATUS_ORDER.map((s) => <button class="menu-item" data-move={s}><StatusIcon state={s} />{STATUS_LABEL[s]}</button>)}
  </div>
  <div class="menu" id="menu-assign" role="menu">
    <div class="menu-head">Assign to</div>
    {OWNERS.filter((o) => o.id !== 'joy').map((o) => <button class="menu-item" data-assign={o.id}>{o.name}</button>)}
  </div>
  <div class="menu" id="menu-sequence" role="menu">
    <div class="menu-head">Add to sequence</div>
    <button class="menu-item" data-seq="Quick follow-up">Quick follow-up</button>
    <button class="menu-item" data-seq="Consult reminder">Consult reminder</button>
    <button class="menu-item" data-seq="Win-back">Win-back</button>
  </div>

  <div id="icons" hidden>
    <span data-ic="chev"><Icon name="chevron-down" size={14} class="chev" /></span>
    <span data-ic="sparkles"><Icon name="sparkles" size={12} /></span>
    {STATUS_ORDER.map((s) => <span data-ic={s}><StatusIcon state={s} /></span>)}
  </div>
  <script type="application/json" id="leads-data" set:html={JSON.stringify({ models, meta })}></script>
  <script>import '../../scripts/leads.ts';</script>
</AppShell>

<style is:global>
  .ltool { background: var(--surface); }
  .ltool .lt-row:first-child { padding-top: 6px; padding-bottom: 6px; }
  .filter-btn { border-style: solid; border-color: var(--line); }
  .filter-btn[aria-pressed="true"], .filter-btn.on { border-color: var(--violet-soft); background: var(--violet-wash); color: var(--violet-deep); }
  .lt-row { border-bottom: 1px solid var(--line); }
  .ltool .lt-row + .lt-row { border-bottom: 1px solid var(--line); }
  .view-trig { display: none; }
  .tm-trig { align-items: center; justify-content: space-between; gap: var(--s-2); min-height: 44px; padding: 0 var(--s-3); border: 1px solid var(--line-strong); border-radius: var(--r-md); background: var(--surface); font-size: var(--t-14); font-weight: 600; color: var(--ink); text-align: left; }
  .tm-trig svg { color: var(--ink-3); flex: none; } .tm-trig[aria-expanded="true"] svg:last-child { transform: rotate(180deg); }
  .cluster { display: flex; align-items: center; gap: var(--s-1); }
  .lsearch { position: relative; display: block; width: 240px; }
  .lsearch svg { position: absolute; left: 9px; top: 50%; transform: translateY(-50%); color: var(--ink-3); pointer-events: none; }
  .lsearch .input { height: 28px; padding-left: 28px; }
  .leads { min-width: 0; }
  .lead-row { --cols: 24px 22px minmax(190px, 1.7fr) minmax(120px, 1fr) 84px 92px 152px 64px 32px; }
  .row.lead-row.head { min-height: 30px; border-bottom-color: var(--line-strong); }
  .lead-row .cell.right { justify-content: flex-end; }
  .lead-row.is-focus { box-shadow: inset 0 0 0 2px var(--violet-soft); }
  .lead-link { display: flex; align-items: baseline; gap: var(--s-2); min-width: 0; }
  .lead-link:hover .name { color: var(--violet-deep); }
  .m-line { display: none; font-size: var(--t-12); color: var(--ink-3); }
  .c-score { gap: var(--s-2); }
  .c-score .tnum { width: 20px; text-align: right; }
  .late { color: var(--attn); }
  .gval { margin-left: auto; flex: none; }
  .l-sub { margin: 0; padding: var(--s-2) var(--s-4); border-bottom: 1px solid var(--line); }
  .group-note { margin: 0; padding: 6px var(--s-4); font-size: var(--t-12); border-bottom: 1px solid var(--line); background: var(--surface); }
  .group[data-collapsed="true"] .group-note { display: none; }
  .lead-row .c-score { justify-content: flex-end; }
  .lead-row .c-score .tnum { width: auto; }
  .lead-row .cell.m-only { display: none; }
  .lead-row .c-own .muted { font-size: var(--t-12); }
  .group-head:focus-visible { outline-offset: -2px; }
  .lfoot { display: flex; align-items: center; gap: var(--s-2); padding: var(--s-4); }
  .menu-item .ck { width: 14px; height: 14px; display: inline-grid; place-items: center; color: var(--violet); flex: none; visibility: hidden; }
  .menu-item[aria-checked="true"] .ck { visibility: visible; }
  .menu-item .ck svg { width: 14px; height: 14px; color: var(--violet); }
  .chip .chip-t { max-width: 180px; overflow: hidden; text-overflow: ellipsis; }
  /* board */
  .rule-bar { display: flex; align-items: center; gap: var(--s-3); padding: 10px var(--s-4); border-bottom: 1px solid var(--line); font-size: var(--t-13); }
  .rule-bar svg { color: var(--joy); flex: none; }
  .rule-bar p { flex: 1; min-width: 0; }
  .board { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(250px, 1fr); gap: 0; overflow-x: auto; padding: 0 var(--s-4) var(--s-6); }
  .bcol { min-width: 0; padding: var(--s-3) var(--s-3) 0; border-right: 1px solid var(--line); }
  .bcol:last-child { border-right: 0; }
  .bcol.drop { background: var(--hover); }
  .bcol-head { display: flex; align-items: center; gap: var(--s-2); height: 30px; font-size: var(--t-13); }
  .bcol-head .cval { margin-left: auto; }
  .bcol-body { display: grid; gap: var(--s-2); align-content: start; max-height: calc(100dvh - 300px); min-height: 120px; overflow-y: auto; padding: var(--s-2) 0 var(--s-3); }
  .bcard { display: grid; gap: 3px; padding: 10px var(--s-3); background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-md); font-size: var(--t-13); cursor: grab; transition: border-color var(--dur) var(--ease); }
  .bcard:hover { border-color: var(--violet-soft); }
  .bcard.dragging { opacity: .45; }
  .bc-top { display: flex; align-items: center; justify-content: space-between; gap: var(--s-2); margin: -4px -6px -2px 0; }
  .bc-top .name:hover { color: var(--violet-deep); }
  .bc-top .icon-btn { width: 24px; height: 24px; }
  .bc-src { display: flex; align-items: center; gap: 5px; }
  .bc-next { color: var(--ink-2); }
  .bcard[hidden] { display: none; }
  /* bulk bar */
  .bulk { position: fixed; z-index: 60; left: calc(50% + var(--rail-w) / 2); transform: translateX(-50%); bottom: 72px; display: flex; align-items: center; gap: var(--s-2); padding: 8px 10px; background: var(--surface); border: 1px solid var(--line-strong); border-radius: var(--r-lg); box-shadow: var(--float); max-width: calc(100vw - 24px); }
  .bulk .strong { padding: 0 var(--s-2); white-space: nowrap; }
  @media (max-width: 960px) { .lsearch { width: 200px; } }
  @media (max-width: 900px) {
    .lt-row { padding-left: var(--s-4); padding-right: 0; position: relative; }
    .ltool .lt-row:first-child .grow, .ltool .lt-row:first-child .tabs { display: none; }
    .ltool .view-trig { display: flex; flex: 1; min-width: 0; gap: var(--s-2); } .ltool .view-trig [data-view-label] { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .ltool .lt-row:first-child { display: flex; flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; padding: 4px 0 4px var(--s-4); }
    .ltool .lt-row:first-child .tabs { padding-right: 0; -webkit-mask-image: none; mask-image: none; overflow: visible; max-width: none; }
    .ltool #filter-row { display: flex; flex-wrap: wrap; gap: var(--s-2); padding: var(--s-2) var(--s-4); overflow: visible; -webkit-mask-image: none; mask-image: none; }
    .ltool #filter-row[hidden] { display: none; }
    .ltool #filter-row .lsearch { flex: 1 1 100%; width: 100%; }
    .ltool #filter-row .lsearch .input { height: 44px; padding-left: 34px; }
    .ltool #filter-row .lsearch svg { left: 12px; }
    .ltool #filter-row .chip { flex: none; }
    .ltool .cluster { display: contents; }
    .ltool .cluster > * { flex: none; }
    .ltool .view-trig { order: -3; } .ltool .filter-btn { order: -2; margin-left: var(--s-2); margin-right: var(--s-1); } .ltool .cluster .icon-btn { display: none; } .ltool .filter-btn .chip-t { display: none; } .ltool .filter-btn { width: 44px; justify-content: center; padding: 0; }
    .ltool .seg { margin-right: var(--s-4); }
    .lead-row { --cols: 22px minmax(0, 1fr) auto 44px; }
    .row.head.lead-row { display: none; }
    .lead-row .c-sel { display: none; }
    .lead-row .c-name { flex-direction: column; align-items: flex-start; gap: 1px; }
    .lead-row .m-line { display: block; }
    .lead-row .cell.m-only { display: flex; flex-direction: column; align-items: flex-end; gap: 0; }
    .lead-row .c-act { justify-content: flex-end; margin-right: -12px; }
    .lead-row .c-act .icon-btn { width: 44px; height: 44px; }
    .lead-row { gap: var(--s-2); }
    .group-head { height: 40px; }
    .board { grid-auto-columns: 82vw; scroll-snap-type: x mandatory; padding: 0 var(--s-4) var(--s-5); scroll-padding: 0 var(--s-4); }
    .bcol { scroll-snap-align: start; }
    .bcol-body { max-height: none; }
    .bulk { left: 12px; right: 12px; transform: none; bottom: calc(132px + env(safe-area-inset-bottom)); overflow-x: auto; }
    .bulk > * { flex: none; }
    .rule-bar { flex-wrap: wrap; } .rule-bar p { flex-basis: calc(100% - 30px); }
  }
</style>
