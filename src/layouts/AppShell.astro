---
import '../styles/base.css';
import '../styles/components.css';
import '../styles/demo.css';
import Icon from '../components/Icon.astro';
import Avatar from '../components/Avatar.astro';
import DashGuide from '../components/DashGuide.astro';
import DemoPick from '../components/DemoPick.astro';
import { NAV, ALL_NAV, TABS } from '../lib/nav.ts';
import { SALON, OWNER, LOCATIONS } from '../data/salon.ts';
import { LEADS, CLIENTS } from '../data/seed.ts';
import { ANSWERS, SUGGESTED } from '../data/dash.ts';
import { NAV_COUNTS, CUR } from '../data/metrics.ts';
import { NOW, DAY } from '../data/clock.ts';

interface Props { title: string; active: string; crumbs?: { label: string; href?: string }[]; flush?: boolean; description?: string }
const { title, active, crumbs, flush = false, description } = Astro.props;
const parent = ALL_NAV.find((n) => n.key === active);
const trail = crumbs ?? [{ label: title }];
const tabKeys = new Set(TABS.map((t) => t.key));
const moreItems = ALL_NAV.filter((n) => !tabKeys.has(n.key));

const cmd = {
  pages: ALL_NAV.map((n) => ({ label: n.label, href: n.href, icon: n.icon, k: n.key2 })),
  actions: [
    { label: 'Ask Dash a question', dash: true, icon: 'sparkles' },
    { label: 'Take the tour with Dash', href: '/?tour=1', icon: 'graduation-cap' },
    { label: 'Leads: not answered', href: '/leads?status=not_answered', icon: 'circle-alert' },
    { label: 'Leads: needs a person', href: '/leads?status=needs_person', icon: 'user-round' },
    { label: 'Bookings: requests to confirm', href: '/bookings', icon: 'calendar-check' },
    { label: 'Retention: win back overdue clients', href: '/retention', icon: 'repeat' },
    { label: 'Marketing: which channel pays back', href: '/marketing', icon: 'megaphone' },
  ],
  leads: LEADS.filter((l) => l.firstTouchAt > NOW - 30 * DAY).slice(0, 160).map((l) => ({ label: l.name, hint: `Lead · ${l.status.replace('_', ' ')}`, href: `/leads/${l.id}` })),
  clients: CLIENTS.slice(0, 160).map((c) => ({ label: c.name, hint: 'Client', href: `/clients/${c.id}` })),
};
const dashData = { answers: ANSWERS, suggested: SUGGESTED };
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#F5F3EF" />
    <title>{title} · PRISM</title>
    <meta name="description" content={description ?? `${title} in PRISM, the growth desk for ${SALON.name}. Prototype with fictitious data.`} />
    <link rel="icon" type="image/svg+xml" href="/brand/mark-color.svg" />
  </head>
  <body>
    <div class="app">
      <aside class="rail" aria-label="Primary" data-tour-nav>
        <a class="brand" href="/" aria-label="PRISM home">
          <img class="brand-mark" src="/brand/mark-color.svg" alt="" width="28" height="32" />
          <img class="brand-word" src="/brand/wordmark-midnight-bold.svg" alt="PRISM" width="70" height="22" />
        </a>
        {LOCATIONS.length > 1 ? (
          <button type="button" class="brand-salon loc-trig" data-menu="menu-loc" aria-haspopup="menu" aria-expanded="false" aria-label="Choose company or location">
            <span class="loc-cur truncate" data-loc-label>{SALON.name} · All locations</span><Icon name="chevrons-up-down" size={13} />
          </button>
        ) : (<div class="brand-salon">{SALON.name} · {SALON.place}</div>)}
        {NAV.map((g) => (
          <nav class="rail-group" aria-label={g.group}>
            <div class="rail-label">{g.group}</div>
            {g.items.map((n) => (
              <a class="nav-item" href={n.href} title={n.label} aria-current={n.key === active ? 'page' : undefined}>
                <Icon name={n.icon} size={16} /><span class="nav-label">{n.label}</span>
                {n.count ? <span class={`nav-count ${n.hot ? 'hot' : ''}`}>{n.count}</span> : null}
                {n.progress && <span class="nav-pill tnum" data-nav-pct>0%</span>}
              </a>
            ))}
          </nav>
        ))}
        <div class="rail-foot">
          <a class="joy-card" href="/joy" data-tour-joy>
            <Avatar kind="joy" size="md" />
            <span><strong><span class="live-dot" style="display:inline-block;margin-right:6px;vertical-align:1px"></span>Joy is on</strong><small>Texts, DMs and calls</small></span>
          </a>
          <div class="user-row"><Avatar name={OWNER.name} size="md" /><span>{OWNER.name}<small>{OWNER.role}</small></span></div>
        </div>
      </aside>

      <div class="main">
        <header class="topbar">
          <a class="topbar-mark only-m" href="/" aria-label="PRISM home"><img class="tm-mark" src="/brand/mark-color.svg" alt="" width="22" height="25" /><img class="tm-word" src="/brand/wordmark-midnight-bold.svg" alt="PRISM" width="69" height="16" /></a>
          <nav class={`crumbs${active === 'home' ? ' crumbs-home' : ''}`} aria-label="Breadcrumb">
            {parent && crumbs && <><a href={parent.href}>{parent.label}</a><Icon name="chevron-right" size={14} /></>}
            {trail.map((c, i) => (<>{i > 0 && <Icon name="chevron-right" size={14} />}{c.href ? <a href={c.href}>{c.label}</a> : <span class="here truncate">{c.label}</span>}</>))}
          </nav>
          <div class="top-spacer"></div>
          {LOCATIONS.length > 1 && <button type="button" class="loc-m only-m" data-menu="menu-loc" aria-haspopup="menu" aria-expanded="false" aria-label="Choose company or location"><Icon name="map-pin" size={14} /><span class="truncate" data-loc-short>All</span></button>}
          <slot name="actions" />
          <DemoPick />
          <button class="search-trigger hide-m" data-tour-search data-open-palette aria-label="Search and commands"><Icon name="search" size={15} /><span>Search or jump to…</span><span class="kbd">⌘K</span></button>
          <button class="icon-btn only-m" data-open-palette aria-label="Search"><Icon name="search" size={18} /></button>
          <button class="btn btn-dash hide-m" data-tour-dash data-open-dash aria-label="Ask Dash"><img src="/brand/dash-mark.svg" alt="" width="16" height="16" />Ask Dash</button>
          <button class="icon-btn only-m" data-tour-dash-m data-open-dash aria-label="Ask Dash"><img src="/brand/dash-mark.svg" alt="" width="20" height="20" /></button>
          <a class="icon-btn" href="/inbox" aria-label={`Inbox, ${NAV_COUNTS.inbox} need a reply`}><Icon name="bell" size={16} /><span class="badge-dot"></span></a>
        </header>
        <slot name="toolbar" />
        <main class={`content ${flush ? 'flush' : ''}`} id="main"><slot /></main>
      </div>
    </div>

    <nav class="tabbar" aria-label="Primary">
      {TABS.map((t) => (<a href={t.href} aria-current={t.key === active ? 'page' : undefined}><Icon name={t.icon} size={21} />{t.label}{t.count ? <span class="pip">{t.count > 99 ? '99+' : t.count}</span> : null}</a>))}
      <button data-open-sheet aria-label="More"><Icon name="ellipsis" size={21} />More</button>
    </nav>

    <div class="scrim" id="scrim"></div>
    <div class="sheet" id="sheet" role="dialog" aria-label="More">
      <div class="sheet-grip"></div>
      <div class="sheet-grid">{moreItems.map((n) => (<a href={n.href}><Icon name={n.icon} size={20} />{n.label}</a>))}</div>
    </div>

    <div class="palette" id="palette" role="dialog" aria-modal="true" aria-label="Command palette">
      <div class="palette-input"><Icon name="search" size={17} /><input id="palette-input" placeholder="Search leads, clients, pages, or run a command" autocomplete="off" spellcheck="false" aria-label="Search" /><span class="kbd">esc</span></div>
      <div class="palette-list" id="palette-list" role="listbox"></div>
      <div class="palette-foot"><span><span class="kbd">↑</span><span class="kbd">↓</span>move</span><span><span class="kbd">↵</span>open</span><span><span class="kbd">g</span>then a letter jumps to a page</span></div>
    </div>

    <aside class="drawer" id="dash" role="dialog" aria-label="Ask Dash" aria-hidden="true">
      <div class="drawer-head">
        <Avatar kind="dash" size="lg" /><div style="flex:1;min-width:0"><div class="t-head">Ask Dash</div><div class="t-meta">Answers from your leads, clients, ads and bookings</div></div>
        <button class="icon-btn" data-close-dash aria-label="Close"><Icon name="x" size={16} /></button>
      </div>
      <div class="drawer-body" id="dash-log">
        <div class="ask-msg dash"><span>Ask me about leads, ads, clients or bookings. Every answer ends in something you can do.</span></div>
        <div class="suggest" id="dash-suggest">{SUGGESTED.map((q) => <button type="button" data-q={q}>{q}</button>)}</div>
      </div>
      <form class="drawer-foot" id="dash-form"><div style="display:flex;gap:8px"><input class="input" id="dash-input" placeholder="Ask a question" autocomplete="off" aria-label="Ask Dash a question" /><button class="btn btn-primary" type="submit">Ask</button></div></form>
      <p class="t-small muted dash-tour"><a class="link" href="/?tour=1">New here? Take the tour with Dash</a></p>
    </aside>

    <DashGuide owner={OWNER.name.split(' ')[0]} salon={SALON.name} suggested={SUGGESTED} counts={{ leads: NAV_COUNTS.leads, inbox: NAV_COUNTS.inbox, bookings: NAV_COUNTS.bookings }} />
    <div class="toast" id="toast" role="status" aria-live="polite"><span id="toast-msg"></span><button id="toast-undo" hidden>Undo</button></div>
    {LOCATIONS.length > 1 && (
      <div class="menu" id="menu-loc" role="menu" aria-label="Company and locations">
        <div class="menu-head">Company</div>
        <button type="button" class="menu-item" role="menuitemradio" data-loc="all" data-loc-name={`${SALON.name} · All locations`} data-active="true"><Icon name="building-2" size={15} /><span>{SALON.name}<small class="loc-sub">All locations</small></span><Icon name="check" size={14} class="loc-check" /></button>
        <div class="menu-sep"></div>
        <div class="menu-head">Locations</div>
        {LOCATIONS.map((l) => (
          <button type="button" class="menu-item" role="menuitemradio" data-loc={l.id} data-loc-name={`${SALON.name} · ${l.name}`}><Icon name="map-pin" size={15} /><span>{l.name}<small class="loc-sub">{l.address}</small></span><Icon name="check" size={14} class="loc-check" /></button>
        ))}
      </div>
    )}
    <script type="application/json" id="cmd-data" set:html={JSON.stringify(cmd)}></script>
    <script type="application/json" id="dash-data" set:html={JSON.stringify(dashData)}></script>
    <script is:inline>try { if (!sessionStorage.getItem('prism-in')) location.replace('/login'); } catch (e) {}</script>
    <script is:inline>try { var ob = JSON.parse(localStorage.getItem('prism-onboarding') || '{}'); document.querySelectorAll('[data-nav-pct]').forEach(function (el) { el.textContent = (ob.pct || 0) + '%'; }); } catch (e) {}</script>
    <script>import '../scripts/ui.ts'; import '../scripts/guide.ts'; import '../scripts/demo.ts';</script>
  </body>
</html>
