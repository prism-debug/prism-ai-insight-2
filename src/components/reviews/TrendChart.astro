---
interface Props { data: { label: string; n: number; avg: number }[]; height?: number }
const { data, height = 190 } = Astro.props;
const lo = 4.0, hi = 5.0, W = 560, H = height, pad = { l: 30, r: 10, t: 14, b: 34 };
const x = (i: number) => pad.l + ((W - pad.l - pad.r) * (i + 0.5)) / data.length;
const y = (v: number) => pad.t + (H - pad.t - pad.b) * (1 - (Math.min(hi, Math.max(lo, v)) - lo) / (hi - lo));
const line = data.map((d, i) => `${i ? 'L' : 'M'}${x(i).toFixed(1)} ${y(d.avg).toFixed(1)}`).join(' ');
const maxN = Math.ceil(Math.max(...data.map((d) => d.n)) / 10) * 10;
const summary = 'Average rating by month: ' + data.map((d) => `${d.label} ${d.avg.toFixed(2)} from ${d.n} reviews`).join('; ');
---
<svg viewBox={`0 0 ${W} ${H}`} width="100%" role="img" aria-label={summary} style="display:block;height:auto;max-width:100%">
  {[4.0, 4.5, 5.0].map((t) => <g><line x1={pad.l} x2={W - pad.r} y1={y(t)} y2={y(t)} stroke="var(--line)" /><text x="0" y={y(t) + 3} font-size="11" fill="var(--ink-3)">{t.toFixed(1)}</text></g>)}
  {data.map((d, i) => <rect x={x(i) - 9} y={H - pad.b + 4 - (d.n / maxN) * 14} width="18" height={(d.n / maxN) * 14} rx="2" fill="var(--d-orange)" fill-opacity="0.75" style="pointer-events:none" />)}
  <path d={line} fill="none" stroke="var(--d-teal)" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round" style="pointer-events:none" />
  {data.map((d, i) => <circle class="tc-dot" cx={x(i)} cy={y(d.avg)} r="3.5" fill="var(--surface)" stroke="var(--d-teal)" stroke-width="2" style="pointer-events:none" />)}
  {data.map((d, i) => <rect class="tc-hit" tabindex="0" x={x(i) - (W - pad.l - pad.r) / data.length / 2} y={pad.t - 6} width={(W - pad.l - pad.r) / data.length} height={H - pad.t - pad.b + 12} data-tip={`${d.label}|Average rating~${d.avg.toFixed(2)} out of 5|Reviews that month~${d.n}`} />)}
  {data.map((d, i) => <text x={x(i)} y={H - 3} font-size="11" text-anchor="middle" fill="var(--ink-3)">{d.label}</text>)}
</svg>
<style>
  .tc-hit { fill: transparent; outline: none; transition: fill var(--dur) var(--ease); }
  .tc-hit:hover, .tc-hit:focus-visible { fill: var(--violet-wash); }
</style>
