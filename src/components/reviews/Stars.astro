---
import Icon from '../Icon.astro';
interface Props { n: number; size?: number }
const { n, size = 13 } = Astro.props;
---
<span class="stars" role="img" aria-label={`${n} out of 5 stars`}>{[1, 2, 3, 4, 5].map((i) => <span class={i <= Math.round(n) ? 'on' : ''}><Icon name="star" size={size} /></span>)}</span>
<style>
  .stars { display: inline-flex; gap: 1px; color: var(--line-strong); flex: none; }
  .stars :global(svg) { fill: currentColor; stroke: none; }
  .stars .on { color: var(--ink-3); }
</style>
